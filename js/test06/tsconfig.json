{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["./**/*.ts", "../test05/**/*.ts", "../src/session/**/*.ts", "../src/hosts/**/*.ts"]
}
