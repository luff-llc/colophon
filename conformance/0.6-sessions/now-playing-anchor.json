    "integers": "integer tokens (no fraction, no exponent), 0 to 2^53 - 1",
    "text": "1 to 1,024 UTF-8 bytes, not only Unicode White_Space, no Cc control character",
    "maximumBytes": 8192,
    "errorOrder": [
      "tooLarge",
      "syntax",
      "duplicateField",
      "notObject",
      "unknownField",
      "missingField",
      "wrongType",
      "outOfRange",
      "badText",
      "notCanonical"
    ],
    "translate": "ageMs = clamp(now + clamp(offset, ±(2^53-1)) - at, ±(2^53-1)); paused: positionMs, elapsed 0, bound 0; playing: elapsedMs = clamp(ageMs, 0, maximumProjectionMs), capped = ageMs > maximumProjectionMs, positionMs + floor(ratePermille × elapsedMs / 1000) saturating at 2^53-1; errorBoundMs = ceil(ratePermille × (offsetErrorMs + ceil(sampleAgeMs / 1000)) / 1000) saturating at 2^53-1"
  },
